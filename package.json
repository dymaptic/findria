{
  "name": "findria",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "postbuild": "node scripts/build-scripts.js",
    "queue": "node dist/process-queue.js",
    "fix:embeddings": "npx tsx scripts/fix-embeddings.ts",
    "start": "next start",
    "lint": "eslint .",
    "db:migrate": "npx tsx scripts/migrate.ts",
    "index": "npx tsx scripts/index.ts",
    "index:living-atlas": "npx tsx scripts/index-living-atlas.ts",
    "index:geoparquet": "npx tsx scripts/index-geoparquet.ts",
    "index:coverage": "npx tsx scripts/compute-coverage.ts",
    "index:custom": "npx tsx scripts/index-custom-sources.ts",
    "index:url": "npx tsx scripts/index-url.ts",
    "index:queue": "npx tsx scripts/process-queue.ts",
    "index:all": "npm run index:living-atlas && npm run index:geoparquet && npm run index:custom",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/",
    "test:guardrails": "npx tsx scripts/test-guardrails.ts",
    "test:comprehensive": "npx tsx scripts/comprehensive-test.ts",
    "test:queries": "npx tsx scripts/run-test-queries.ts",
    "test:all": "npm run test && npm run test:guardrails && npm run test:queries",
    "test:deploy": "npm run test && echo '\\n--- Waiting 65s for rate limit reset ---\\n' && sleep 65 && npm run test:guardrails"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@turf/bbox": "^7.3.4",
    "@turf/bbox-polygon": "^7.3.4",
    "@turf/boolean-intersects": "^7.3.4",
    "@turf/buffer": "^7.3.4",
    "@turf/helpers": "^7.3.4",
    "@turf/simplify": "^7.3.4",
    "@turf/union": "^7.3.4",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.3",
    "duckdb-async": "^1.4.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.2",
    "h3-js": "^4.4.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "openai": "^6.15.0",
    "postcss": "^8.5.6",
    "postgres": "^3.4.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^30.0.0",
    "@types/proj4": "^2.5.6",
    "jest": "^30.2.0",
    "proj4": "^2.20.2",
    "ts-jest": "^29.4.6"
