# Copy to .env.local and fill in values. Never commit real secrets.

# --- Database (required) ---
# PostgreSQL with pgvector + PostGIS. Default matches docker-compose.yml for local dev.
DATABASE_URL=postgresql://datalibrarian:datalibrarian@localhost:5432/datalibrarian

# --- AI APIs (required) ---
# Anthropic: query parsing, AI chat, and the guardrail classifier
ANTHROPIC_API_KEY=your-anthropic-api-key
# OpenAI: embeddings (text-embedding-3-small)
OPENAI_API_KEY=your-openai-api-key

# --- ArcGIS ---
# Exposed to the browser for basemaps (build-time). Use a key restricted to your domains.
NEXT_PUBLIC_ARCGIS_API_KEY=your-arcgis-api-key
# Server-side ArcGIS key (optional; not currently read by the app - geocoding uses the public World Geocoder)
ARCGIS_API_KEY=your-arcgis-api-key

# --- Application ---
# Public site URL, used for metadata and OG images (resolved at build time for static pages)
BASE_URL=http://localhost:3000
# Base URL the MCP endpoint (/api/mcp) uses to call /api/search on this server
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Admin area (/admin, HTTP Basic auth) ---
# The admin area is unavailable unless both are set. Use a strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Optional ---
# Max URL submissions per IP per hour on /api/sources/submit (default: 25)
SUBMISSION_RATE_LIMIT_PER_HOUR=25
# Plausible Analytics script URL, e.g. https://plausible.io/js/your-site-script.js. Leave empty to disable analytics.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=

# --- Integration test scripts (npm run test:guardrails / test:queries / test:comprehensive) ---
# Server the test harnesses send requests to (default: http://localhost:3000)
TEST_BASE_URL=http://localhost:3000
